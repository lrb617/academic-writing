export OPENAI_API_KEY=
export OPENAI_BASE_URL=

# claude CLI 通过 ANTHROPIC_* 环境变量读取配置；CLI 会自动拼接 /v1/messages，
# 所以这里 ANTHROPIC_BASE_URL 不能带 /v1（OPENAI_BASE_URL 仍需 /v1）
export ANTHROPIC_API_KEY=
export ANTHROPIC_BASE_URL=

# 指定使用的模型名称（根据中转站支持的模型填写，例如：gpt-4o, gpt-4o-mini, deepseek-chat 等）
export OPENAI_MODEL=

# 学术文献检索所需的 Key（通过 OpenRouter 调用 Perplexity sonar-pro-search）
export OPENROUTER_API_KEY=

# 联网搜索功能所需的 Key（保留原有配置）
export PARALLEL_API_KEY=
